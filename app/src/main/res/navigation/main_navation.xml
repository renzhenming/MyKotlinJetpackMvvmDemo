<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_navation"
    app:startDestination="@id/mainfragment">

    <fragment
        android:id="@+id/mainfragment"
        android:name="com.rzm.myjetpack.ui.main.MainFragment"
        android:label="HomeFragment">

        <action
            android:id="@+id/action_mainfragment_to_searchFragment"
            app:destination="@id/searchFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
        <action
            android:id="@+id/action_mainfragment_to_systemArrFragment"
            app:destination="@id/systemArrFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
        <action
            android:id="@+id/action_mainfragment_to_lookInfoFragment"
            app:destination="@id/lookInfoFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
        <action
            android:id="@+id/action_mainfragment_to_integralFragment"

            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
        <action
            android:id="@+id/action_mainfragment_to_collectFragment"
            app:destination="@id/collectFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
        <action
            android:id="@+id/action_mainfragment_to_addAriticleFragment"
            app:destination="@id/addAriticleFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
        <action
            android:id="@+id/action_mainfragment_to_ariticleFragment"
            app:destination="@id/ariticleFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
        <action
            android:id="@+id/action_mainfragment_to_todoListFragment"
            app:destination="@id/todoListFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
        <action
            android:id="@+id/action_mainfragment_to_settingFragment"
            app:destination="@id/settingFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />

    </fragment>
    <fragment
        android:id="@+id/searchFragment"
        android:name="com.rzm.myjetpack.ui.main.sub.search.SearchFragment"
        android:label="SearchFragment">

    </fragment>

    <fragment
        android:id="@+id/webFragment"
        android:name="com.rzm.myjetpack.ui.main.web.WebFragment"
        android:label="WebFragment" />

    <fragment
        android:id="@+id/systemArrFragment"
        android:name="com.rzm.myjetpack.ui.main.sub.systemarr.SystemArrFragment"
        android:label="SystemArrFragment">

    </fragment>
    <fragment
        android:id="@+id/lookInfoFragment"
        android:name="com.rzm.myjetpack.ui.main.sub.lookinfo.LookInfoFragment"
        android:label="LookInfoFragment" />
    <fragment
        android:id="@+id/integralFragment"
        android:name="com.rzm.myjetpack.ui.main.sub.integral.IntegralFragment"
        android:label="IntegralFragment">

    </fragment>

    <fragment
        android:id="@+id/collectFragment"
        android:name="com.rzm.myjetpack.ui.main.sub.collect.CollectFragment"
        android:label="CollectFragment" />

    <fragment
        android:id="@+id/addAriticleFragment"
        android:name="com.rzm.myjetpack.ui.main.sub.article.AddArticleFragment"
        android:label="AddArticleFragment" />
    <fragment
        android:id="@+id/ariticleFragment"
        android:name="com.rzm.myjetpack.ui.main.sub.article.ArticleFragment"
        android:label="AriticleFragment">
        <action
            android:id="@+id/action_ariticleFragment_to_addAriticleFragment"
            app:destination="@id/addAriticleFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
    </fragment>
    <fragment
        android:id="@+id/todoListFragment"
        android:name="com.rzm.myjetpack.ui.main.sub.todolist.TodoListFragment"
        android:label="TodoListFragment">

    </fragment>

    <action
        android:id="@+id/action_to_webFragment"
        app:destination="@id/webFragment"
        app:enterAnim="@anim/slide_in_right"
        app:exitAnim="@anim/slide_out_left"
        app:popEnterAnim="@anim/slide_in_left"
        app:popExitAnim="@anim/slide_out_right" />
    <fragment
        android:id="@+id/settingFragment"
        android:name="com.rzm.myjetpack.ui.main.sub.setting.SettingFragment"
        android:label="SettingFragment" />

    <action
        android:id="@+id/action_to_loginFragment"
        app:destination="@id/loginFragment"
        app:enterAnim="@anim/slide_in_right"
        app:exitAnim="@anim/slide_out_left"
        app:popEnterAnim="@anim/slide_in_left"
        app:popExitAnim="@anim/slide_out_right" />

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.rzm.myjetpack.ui.main.login.LoginFragment"
        android:label="LoginFragment">
        <action
            android:id="@+id/action_loginFragment_to_registerFrgment"
            app:destination="@id/registerFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
    </fragment>

    <fragment
        android:id="@+id/registerFragment"
        android:name="com.rzm.myjetpack.ui.main.login.RegisterFragment"
        android:label="RegisterFragment">

    </fragment>
</navigation>